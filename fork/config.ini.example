# Merged with main config.ini when [Bot] local_dir_path = fork

[AI_Reply]
enabled = false
# ollama | lm_studio | openai_compatible
provider = ollama
base_url =
model = llama3.2
trigger_keyword = lm
request_timeout_seconds = 120
system_prompt = You are a helpful assistant on a MeshCore radio mesh. Keep answers short and plain text. No markdown.
