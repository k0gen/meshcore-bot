# Merged with main config.ini when [Bot] local_dir_path = fork

[AI_Reply]
enabled = false
# ollama | openai_compatible (LM Studio, etc.)
provider = ollama
base_url = http://127.0.0.1:11434/v1
model = llama3.2
# Comma-separated keywords that will eventually trigger LLM replies (not active yet)
trigger_keywords = ai,ask
max_reply_length = 200
request_timeout_seconds = 120
# Optional system prompt for mesh replies
system_prompt = You are a helpful assistant on a MeshCore radio mesh. Keep answers short and plain text.
